# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daratelier_db?schema=public"

# Authentication Security
JWT_SECRET="dev-jwt-super-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Media Upload Directory
UPLOAD_DIR="./uploads"

# Seed Admin Credentials (Development only)
DEV_ADMIN_EMAIL="admin@dar-atelier.ma"
DEV_ADMIN_PASSWORD="AdminSecure2025!"
