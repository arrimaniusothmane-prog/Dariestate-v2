# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite, no external server required)
DATABASE_URL="file:./dev.db"

# Authentication Security
JWT_SECRET="dev-jwt-super-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Media Upload Directory
UPLOAD_DIR="./uploads"

# Email Configuration (SMTP)
# Choose your email provider: SMTP, Resend, SendGrid, Brevo, etc.
EMAIL_SERVICE="smtp"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="DAR & ATELIER <noreply@dar-atelier.ma>"

# Frontend URL for email verification links
FRONTEND_URL="http://localhost:5173"

# Seed Admin Credentials (Development only)
DEV_ADMIN_EMAIL="admin@dar-atelier.ma"
DEV_ADMIN_PASSWORD="AdminSecure2025!"
