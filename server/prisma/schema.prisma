// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
  CONSTRUCTION_MANAGER
  INTERIOR_DESIGNER
  SALES_REP
  CLIENT
}

enum PropertyType {
  VILLA
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
  OFFICE
  PENTHOUSE
  DUPLEX
}

enum TransactionType {
  BUY
  RENT
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  UNDER_OFFER
  RESERVED
  SOLD
  RENTED
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  NEGOTIATION
  CONVERTED
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum QuoteStatus {
  PENDING
  UNDER_REVIEW
  SITE_VISIT_REQUIRED
  QUOTE_PREPARED
  SENT_TO_CLIENT
  ACCEPTED
  REJECTED
  COMPLETED
}

enum ConstructionStatus {
  PLANNING
  PERMIT_ACQUIRED
  FOUNDATION
  STRUCTURE
  FINISHING
  COMPLETED
  ON_HOLD
}

enum DesignCategory {
  LIVING_ROOM
  KITCHEN
  BEDROOM
  BATHROOM
  OFFICE
  OUTDOOR
  CUSTOM_FURNITURE
  FULL_VILLA
  RENOVATION
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(CLIENT)
  avatar       String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedInquiries     Inquiry[]             @relation("AssignedInquiries")
  assignedQuotes        QuoteRequest[]        @relation("AssignedQuotes")
  managedProjects       ConstructionProject[] @relation("ManagedProjects")
  inquiryNotes          InquiryNote[]
  activityLogs          ActivityLog[]
  favorites             Favorite[]
}

model Property {
  id              String          @id @default(uuid())
  title           String
  slug            String          @unique
  description     String
  type            PropertyType
  transactionType TransactionType
  price           Float
  currency        String          @default("MAD")
  city            String
  neighborhood    String
  address         String
  surfaceArea     Float
  bedrooms        Int
  bathrooms       Int
  status          PropertyStatus  @default(AVAILABLE)
  isFeatured      Boolean         @default(false)
  coverImage      String
  energyRating    String?
  yearBuilt       Int?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  images      PropertyImage[]
  features    PropertyFeature[]
  favorites   Favorite[]
  inquiries   Inquiry[]

  @@index([slug])
  @@index([city])
  @@index([type])
  @@index([transactionType])
  @@index([status])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  alt        String?
  caption    String?
  order      Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyFeature {
  id         String @id @default(uuid())
  propertyId String
  name       String
  category   String? // e.g., "Comfort", "Security", "Exterior", "Tech"

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String?
  propertyId String
  ipSession  String?
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

model Inquiry {
  id                     String        @id @default(uuid())
  name                   String
  email                  String
  phone                  String
  propertyId             String?
  subject                String
  message                String
  preferredContactMethod String        @default("PHONE") // PHONE, EMAIL, WHATSAPP
  source                 String        @default("WEBSITE")
  priority               Priority      @default(MEDIUM)
  status                 InquiryStatus @default(NEW)
  assignedToId           String?
  followUpDate           DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  property   Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      InquiryNote[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
}

model InquiryNote {
  id        String   @id @default(uuid())
  inquiryId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model QuoteRequest {
  id                String      @id @default(uuid())
  fullName          String
  email             String
  phone             String
  city              String
  projectType       String // VILLA_CONSTRUCTION, APARTMENT_BUILDING, RENOVATION, INTERIOR_DESIGN, LANDSCAPING, OTHER
  plotSize          Float?
  estimatedArea     Float?
  numberOfFloors    Int?
  budgetRange       String?
  expectedStartDate String?
  description       String
  status            QuoteStatus @default(PENDING)
  proposedPrice     Float?
  assignedToId      String?
  internalNotes     String?
  attachments       String[]    @default([])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  assignedTo User? @relation("AssignedQuotes", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedToId])
}

model ConstructionProject {
  id                     String             @id @default(uuid())
  title                  String
  clientName             String
  clientEmail            String
  clientPhone            String
  category               String // "Contemporary Villa", "Residential Complex", "Riad Renovation"
  location               String
  contractAmount         Float
  currency               String             @default("MAD")
  startDate              DateTime
  expectedCompletionDate DateTime
  status                 ConstructionStatus @default(PLANNING)
  progressPercentage     Int                @default(0)
  projectManagerId       String?
  coverImage             String
  description            String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  projectManager User?                   @relation("ManagedProjects", fields: [projectManagerId], references: [id], onDelete: SetNull)
  milestones     ConstructionMilestone[]

  @@index([status])
}

model ConstructionMilestone {
  id            String    @id @default(uuid())
  projectId     String
  title         String
  description   String?
  targetDate    DateTime
  completedDate DateTime?
  isCompleted   Boolean   @default(false)
  order         Int       @default(0)

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DesignProject {
  id             String         @id @default(uuid())
  title          String
  slug           String         @unique
  category       DesignCategory
  location       String?
  surfaceArea    Float?
  year           Int            @default(2025)
  description    String
  designApproach String
  materials      String[]       @default([])
  coverImage     String
  galleryImages  String[]       @default([])
  isFeatured     Boolean        @default(false)
  isPublished    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([category])
  @@index([isFeatured])
}

model Review {
  id          String   @id @default(uuid())
  clientName  String
  clientRole  String?  // e.g. "Propriétaire Villa Anfa", "Investisseur"
  rating      Int      @default(5)
  comment     String
  projectType String?  // "Construction Villa", "Aménagement Intérieur"
  isVerified  Boolean  @default(true)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // "PROPERTY_CREATED", "STATUS_UPDATED", "QUOTE_CONVERTED"
  entityType String   // "Property", "Inquiry", "Quote", "Project"
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([createdAt])
}

model CompanySettings {
  id                         String   @id @default("default")
  companyName                String   @default("DAR & ATELIER Architecture & Immobilier")
  logoUrl                    String?
  email                      String   @default("contact@dar-atelier.ma")
  phone                      String   @default("+212 5 22 45 80 90")
  whatsapp                   String   @default("+212 6 61 23 45 67")
  address                    String   @default("Boulevard d'Anfa, Tour Casablanca Finance City, Étage 14")
  city                       String   @default("Casablanca")
  country                    String   @default("Maroc")
  defaultCurrency            String   @default("MAD")
  defaultLanguage            String   @default("fr")
  facebookUrl                String?  @default("https://facebook.com/daratelier")
  instagramUrl               String?  @default("https://instagram.com/daratelier")
  linkedinUrl                String?  @default("https://linkedin.com/company/daratelier")
  metaTitle                  String   @default("DAR & ATELIER | Architecture d'Exception & Immobilier de Prestige")
  metaDescription            String   @default("Villas d'architectes, appartements haut standing, construction sur mesure et aménagement d'espaces exclusifs au Maroc.")
  emailNotificationsEnabled  Boolean  @default(true)
  updatedAt                  DateTime @updatedAt
}
